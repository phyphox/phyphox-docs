<phyphox xmlns="http://phyphox.org/xml" version="1.0" locale="en">
    <title>Container fixture A</title>
    <category>Container fixtures</category>
    <description>First of two experiments in the multi-experiment zip; also the payload of the partial zip.</description>
    <data-containers>
        <container size="8" init="1,2,3">a</container>
        <container size="8">out</container>
    </data-containers>
    <analysis>
        <add>
            <input keep="true">a</input>
            <output>out</output>
        </add>
    </analysis>
    <views>
        <view label="A">
            <value label="out"><input>out</input></value>
        </view>
    </views>
</phyphox>
