# Device-lab assignment - copy to lab.yml (local, NEVER committed: it
# holds serials and host addresses) and adjust. Each host runs
#   python3 tools/lab/run.py --config lab.yml --host <name>
# and produces one JSON; --merge combines them.

hosts:
  macbook:            # the default full set
    host_ip: 192.168.2.50     # how iOS devices reach this host's fixture server
    artifacts:                # optional: enables the languages release check
      # Each artifact belongs on a host that can READ it: the .ipa needs
      # nothing special, the .apk needs aapt from the Android SDK. A
      # MacBook that only drives iPhones has no SDK, so putting
      # artifacts.android here just skips with a notice - give it to the
      # host that builds Android instead. aapt itself is found
      # automatically in the usual SDK locations; `aapt: /full/path`
      # overrides that.
      ios: /path/to/phyphox.ipa
      # a bare path is a RELEASE candidate and a locale mismatch FAILS;
      # for a development build write it as
      #   android: {path: /path/to/dev.apk, release: false}
      # and the comparison is reported without failing the run
    devices:
      # `newest: true` marks the phone the ble suite uses for the
      # scenarios scoped `phones: newest` - the ones that only need to
      # prove they still work, as opposed to the four that run everywhere
      # because BLE behaviour varies by version and manufacturer. Without
      # it the first device of each platform is taken.
      iphone-14-pro: {platform: ios, serial: "UDID-HERE", port: 8081, newest: true}
      iphone-8:      {platform: ios, serial: "UDID-HERE", port: 8082}
      ipad-pro:      {platform: ios, serial: "UDID-HERE", port: 8083}
      pixel-9-pro:   {platform: android, serial: "SERIAL", port: 8091, newest: true}
      pixel-3:       {platform: android, serial: "SERIAL", port: 8092}
      nexus-5x:      {platform: android, serial: "SERIAL", port: 8093}
      galaxy-a3:     {platform: android, serial: "SERIAL", port: 8094}

  linuxbox:           # the split: Android (+ boards, phase 6) here,
    artifacts:        # iOS stays with the MacBook
      android: /path/to/phyphox-release.apk   # the SDK lives here
    devices:
      pixel-9-pro:   {platform: android, serial: "SERIAL", port: 8091, newest: true}
      pixel-3:       {platform: android, serial: "SERIAL", port: 8092}
      nexus-5x:      {platform: android, serial: "SERIAL", port: 8093}
      galaxy-a3:     {platform: android, serial: "SERIAL", port: 8094}
    # the ble suite runs here, where the boards are:
    #   --suites ble --board-port esp32=/dev/ttyUSB0
    #                --board-port nano33ble=/dev/ttyACM1
    #                --micropython-firmware /path/to/ESP32_GENERIC-*.bin
