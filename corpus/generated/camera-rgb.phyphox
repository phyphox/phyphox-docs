<phyphox xmlns="http://phyphox.org/xml" version="1.21" locale="en">
    <!-- Generated fixture: the colour-channel outputs of the camera input
         (file format 1.21, see spec/input.yml, camera components, and
         docs/file-format/input.md "Colour channels"). Every camera
         output mapped once with the photometric feature, so the six new
         components red, green, blue, linearRed, linearGreen and linearBlue
         sit next to the combined quantities they decompose. A parsing
         fixture, not a maintained experiment. -->
    <title>Corpus: camera colour channels</title>
    <category>Corpus</category>
    <description>Generated coverage fixture for the red, green, blue and linear colour-channel outputs of the camera input.</description>
    <data-containers>
        <container size="0">t</container>
        <container size="0">luma</container>
        <container size="0">luminance</container>
        <container size="0">hue</container>
        <container size="0">saturation</container>
        <container size="0">value</container>
        <container size="0">red</container>
        <container size="0">green</container>
        <container size="0">blue</container>
        <container size="0">linearRed</container>
        <container size="0">linearGreen</container>
        <container size="0">linearBlue</container>
        <container size="0">shutterSpeed</container>
        <container size="0">iso</container>
        <container size="0">aperture</container>
    </data-containers>
    <input>
        <camera feature="photometric" x1="0.4" x2="0.6" y1="0.4" y2="0.6" auto_exposure="true" aeStrategy="mean">
            <output component="t">t</output>
            <output component="luma">luma</output>
            <output component="luminance">luminance</output>
            <output component="hue">hue</output>
            <output component="saturation">saturation</output>
            <output component="value">value</output>
            <output component="red">red</output>
            <output component="green">green</output>
            <output component="blue">blue</output>
            <output component="linearRed">linearRed</output>
            <output component="linearGreen">linearGreen</output>
            <output component="linearBlue">linearBlue</output>
            <output component="shutterSpeed">shutterSpeed</output>
            <output component="iso">iso</output>
            <output component="aperture">aperture</output>
        </camera>
    </input>
    <views>
        <view label="Colour">
            <graph label="Gamma-encoded channels" labelX="[[quantity_short_time]]" unitX="@second" labelY="channel" partialUpdate="true">
                <input axis="x" color="red">t</input>
                <input axis="y">red</input>
                <input axis="x" color="green">t</input>
                <input axis="y">green</input>
                <input axis="x" color="blue">t</input>
                <input axis="y">blue</input>
            </graph>
            <graph label="Linear channels" labelX="[[quantity_short_time]]" unitX="@second" labelY="linear channel" partialUpdate="true">
                <input axis="x" color="red">t</input>
                <input axis="y">linearRed</input>
                <input axis="x" color="green">t</input>
                <input axis="y">linearGreen</input>
                <input axis="x" color="blue">t</input>
                <input axis="y">linearBlue</input>
            </graph>
            <value label="Luma" precision="3">
                <input>luma</input>
            </value>
            <value label="Luminance" precision="3">
                <input>luminance</input>
            </value>
            <camera-gui label="Preview" exposure_adjustment_level="3"/>
        </view>
    </views>
    <analysis>
    </analysis>
    <export>
        <set name="Colour channels">
            <data name="t (s)">t</data>
            <data name="red">red</data>
            <data name="green">green</data>
            <data name="blue">blue</data>
            <data name="linear red">linearRed</data>
            <data name="linear green">linearGreen</data>
            <data name="linear blue">linearBlue</data>
            <data name="luma">luma</data>
            <data name="luminance">luminance</data>
        </set>
    </export>
</phyphox>
