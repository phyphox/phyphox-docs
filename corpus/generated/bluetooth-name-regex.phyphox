<!-- Covers the bluetooth nameRegex= attribute (file format 1.21): whole-name
     matching by regular expression, on an input and on an output device,
     once alone and once combined with name= - every criterion given has to
     hold. The patterns are the documentation's examples; the UUIDs are the
     phyphox BLE service and characteristics. -->
<phyphox version="1.21">
    <title>Bluetooth name matching by regular expression</title>
    <category>Corpus</category>
    <description>Fixture for the nameRegex attribute of bluetooth devices.</description>
    <data-containers>
        <container size="0">value</container>
        <container size="1">setting</container>
    </data-containers>
    <input>
        <bluetooth id="exact" nameRegex="phyphox:m" mode="notification">
            <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian">value</output>
        </bluetooth>
    </input>
    <output>
        <bluetooth id="alternatives" name="phyphox" nameRegex="phyphox:(m|mini)">
            <input char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian">setting</input>
        </bluetooth>
    </output>
    <views>
        <view label="Data">
            <value label="Value"><input>value</input></value>
            <edit label="Setting"><output>setting</output></edit>
        </view>
    </views>
</phyphox>
