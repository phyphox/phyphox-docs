<phyphox version="1.0" locale="en">
    <title>Xmas receiver</title>
    <category>Fun</category>
    <icon format="base64">
        </icon>
    <description>
        Decode the mysterious sounds, i.e. our christmas message on http://phyphox.org/xmas 
    </description>
    <translations>
        <translation locale="de">
            <title>Weihnachtsempfänger</title>
            <category>Spaß</category>
            <description>
                Entschlüssle die merkwürdigen Töne unserer Weihnachtsnachricht auf http://phyphox.org/xmas
            </description>
            <string original="Xmas message">Weihnachtsbotschaft</string>
            <string original="Frequency 1 (Hz)">Frequenz 1 (Hz)</string>
            <string original="Frequency 2 (Hz)">Frequenz 2 (Hz)</string>
            <string original="Start this experiment and play the audio of our christmas message on another device, so your phone can hear it. Watch as the pixels slowly start to form an image. More info on phyphox.org/xmas.">Starte dieses Experiment und spiele den Ton unserer Weihnachtsnachricht auf einem zweiten Gerät ab, so dass dein Smartphone es hören kann. Sieh zu, wie die Pixel sich langsam zu einem Bild formen. Mehr Infos auf phyphox.org/xmas.</string>
        </translation>
    </translations>
    <data-containers>
        <container size="1024">recording</container>
        <container size="1024" static="true">time</container>
        <container size="1024" static="true">frequency</container>
        <container size="1024">fftX</container>
        <container size="1024">fftY</container>
        <container size="100">partFrequency</container>
        <container size="100">partFFTtempX</container>
        <container size="100">partFFTtempY</container>
        <container size="100">partFFTtempX2</container>
        <container size="100">partFFTtempY2</container>
        <container size="100">partFFT</container>
        <container size="100">partFrequencyX</container>
        <container size="100">partFFTX</container>
        <container size="100">partFrequencyY</container>
        <container size="100">partFFTY</container>
        <container size="100">partFrequencyC</container>
        <container size="100">partFFTC</container>
        <container size="100">partFrequencyCheck</container>
        <container size="100">partFFTCheck</container>
        <container size="1">f1new</container>
        <container size="8">f1_r</container>
        <container size="0">f1</container>
        <container size="1">f2new</container>
        <container size="0">f2</container>
        <container size="8">f2_r</container>
        <container size="1">f3new</container>
        <container size="1">f4new</container>
        <container size="1">colornew</container>
        <container size="8">color_r</container>
        <container size="0">color</container>
        <container size="1">repeat</container>
        <container size="1">repeat_stop</container>
        <container size="1">valid</container>
        <container size="0">x</container>
        <container size="0">y</container>
        <container size="0">z</container>
    </data-containers>  
    <input>
        <audio rate="48000">
            <output>recording</output>
        </audio>
    </input>
    <views>
        <view label="Message">
            <graph label="Xmas message" labelX="Frequency 1" unitX="Hz" labelY="Frequency 2" unitY="Hz" labelZ="Color" style="map" aspectRatio="1" minX="890.625" maxX="3890.625" minY="3937.5" maxY="6937.5" minZ="0" maxZ="7" scaleMinX="fixed" scaleMaxX="fixed" scaleMinY="fixed" scaleMaxY="fixed" scaleMinZ="fixed" scaleMaxZ="fixed" mapWidth="64" mapColor1="000000" mapColor2="0000ff" mapColor3="ff00ff" mapColor4="ff0000" mapColor5="ffff00" mapColor6="00ff00" mapColor7="00ffff" mapColor8="ffffff">
                <input axis="x">x</input>
                <input axis="y">y</input>
                <input axis="z">z</input>
            </graph>
            <info label="Start this experiment and play the audio of our christmas message on another device, so your phone can hear it. Watch as the pixels slowly start to form an image. More info on phyphox.org/xmas." />
        </view>
    </views>
    <analysis sleep="0.022">
        <ramp>
            <input as="start" type="value">0</input>
            <input as="stop" type="value">21.3125</input>
            <output>time</output>
        </ramp>
        <ramp>
            <input as="start" type="value">0</input>
            <input as="stop" type="value">47953</input>
            <output>frequency</output>
        </ramp>

        <fft>
            <input clear="false">recording</input>
            <output as="re">fftX</output>
            <output as="im">fftY</output>
        </fft>
        <rangefilter>
            <input clear="false">frequency</input>
            <input as="min" type="value">890</input>
            <input as="max" type="value">3900</input>
            <input clear="false">fftX</input>
            <input clear="false">fftY</input>
            <output>partFrequencyX</output>
            <output>partFFTtempX</output>
            <output>partFFTtempY</output>
        </rangefilter>
        <multiply>
            <input clear="false">partFFTtempX</input>
            <input>partFFTtempX</input>
            <output>partFFTtempX2</output>
        </multiply>
        <multiply>
            <input clear="false">partFFTtempY</input>
            <input>partFFTtempY</input>
            <output>partFFTtempY2</output>
        </multiply>
        <add>
            <input>partFFTtempX2</input>
            <input>partFFTtempY2</input>
            <output>partFFTX</output>
        </add>

        <rangefilter>
            <input clear="false">frequency</input>
            <input as="min" type="value">3900</input>
            <input as="max" type="value">6900</input>
            <input clear="false">fftX</input>
            <input clear="false">fftY</input>
            <output>partFrequencyY</output>
            <output>partFFTtempX</output>
            <output>partFFTtempY</output>
        </rangefilter>
        <multiply>
            <input clear="false">partFFTtempX</input>
            <input>partFFTtempX</input>
            <output>partFFTtempX2</output>
        </multiply>
        <multiply>
            <input clear="false">partFFTtempY</input>
            <input>partFFTtempY</input>
            <output>partFFTtempY2</output>
        </multiply>
        <add>
            <input>partFFTtempX2</input>
            <input>partFFTtempY2</input>
            <output>partFFTY</output>
        </add>

        <rangefilter>
            <input clear="false">frequency</input>
            <input as="min" type="value">6900</input>
            <input as="max" type="value">10000</input>
            <input clear="false">fftX</input>
            <input clear="false">fftY</input>
            <output>partFrequencyC</output>
            <output>partFFTtempX</output>
            <output>partFFTtempY</output>
        </rangefilter>
        <multiply>
            <input clear="false">partFFTtempX</input>
            <input>partFFTtempX</input>
            <output>partFFTtempX2</output>
        </multiply>
        <multiply>
            <input clear="false">partFFTtempY</input>
            <input>partFFTtempY</input>
            <output>partFFTtempY2</output>
        </multiply>
        <add>
            <input>partFFTtempX2</input>
            <input>partFFTtempY2</input>
            <output>partFFTC</output>
        </add>

        <rangefilter>
            <input>frequency</input>
            <input as="min" type="value">10000</input>
            <input as="max" type="value">10800</input>
            <input>fftX</input>
            <input>fftY</input>
            <output>partFrequencyCheck</output>
            <output>partFFTtempX</output>
            <output>partFFTtempY</output>
        </rangefilter>
        <multiply>
            <input clear="false">partFFTtempX</input>
            <input>partFFTtempX</input>
            <output>partFFTtempX2</output>
        </multiply>
        <multiply>
            <input clear="false">partFFTtempY</input>
            <input>partFFTtempY</input>
            <output>partFFTtempY2</output>
        </multiply>
        <add>
            <input>partFFTtempX2</input>
            <input>partFFTtempY2</input>
            <output>partFFTCheck</output>
        </add>

        <max>
            <input as="y" clear="false">partFFTX</input>
            <input as="x" clear="false">partFrequencyX</input>
            <output as="position" clear="false">f1new</output>
        </max>
        <max>
            <input as="y" clear="false">partFFTY</input>
            <input as="x" clear="false">partFrequencyY</input>
            <output as="position" clear="false">f2new</output>
        </max>
        <max>
            <input as="y" clear="false">partFFTC</input>
            <input as="x" clear="false">partFrequencyC</input>
            <output as="position" clear="false">f3new</output>
        </max>
        <max>
            <input as="y" clear="false">partFFTCheck</input>
            <input as="x" clear="false">partFrequencyCheck</input>
            <output as="position" clear="false">f4new</output>
        </max>

        <formula formula="round(([1] - 6984.375)/46.875) % 8">
            <input clear="false">f3new</input>
            <output clear="false">colornew</output>
        </formula>

        <formula formula="floor(round(([1] - 6984.375)/46.875) / 8)+1">
            <input clear="false">f3new</input>
            <output clear="false">repeat</output>
        </formula>

        <formula formula="[2]+([1]-1)*46.875">
            <input clear="false">repeat</input>
            <input clear="false">f1new</input>
            <output clear="false">repeat_stop</output>
        </formula>

        <ramp>
            <input as="start" clear="false">f1new</input>
            <input as="stop">repeat_stop</input>
            <input as="length" clear="false">repeat</input>
            <output clear="false">f1_r</output>
        </ramp>

        <const>
            <input as="value" clear="false">f2new</input>
            <input as="length" clear="false">repeat</input>
            <output clear="false">f2_r</output>
        </const>

        <const>
            <input as="value">colornew</input>
            <input as="length" clear="true">repeat</input>
            <output clear="false">color_r</output>
        </const>

        <formula formula="heaviside(0.1 - abs(round((([1]-890.625)/46.875) + round(([2]-3937.5)/46.875) + round(([3]-6984.375)/46.875))%16 - round(([4]-10031.25)/46.875)))">
            <input>f1new</input>
            <input>f2new</input>
            <input>f3new</input>
            <input>f4new</input>
            <output>valid</output>
        </formula>

        <if equal="true">
            <input clear="false">valid</input>
            <input type="value">1</input>
            <input>f1_r</input>
            <output clear="false">f1</output>
        </if>

        <if equal="true">
            <input clear="false">valid</input>
            <input type="value">1</input>
            <input>f2_r</input>
            <output clear="false">f2</output>
        </if>

        <if equal="true">
            <input clear="false">valid</input>
            <input type="value">1</input>
            <input>color_r</input>
            <output clear="false">color</output>
        </if>

        <map zMode="average">
            <input as="mapWidth" type="value">64</input>
            <input as="minX" type="value">890.625</input>
            <input as="maxX" type="value">3890.625</input>
            <input as="mapHeight" type="value">64</input>
            <input as="minY" type="value">3937.5</input>
            <input as="maxY" type="value">6937.5</input>
            <input as="x" clear="false">f1</input>
            <input as="y" clear="false">f2</input>
            <input as="z" clear="false">color</input>
            <output as="x">x</output>
            <output as="y">y</output>
            <output as="z">z</output>
        </map>
    </analysis>
    <export>
        <set name="Xmas message">
            <data name="Frequency 1 (Hz)">x</data>
            <data name="Frequency 2 (Hz)">y</data>
            <data name="Color">z</data>
        </set>
    </export>
</phyphox>
