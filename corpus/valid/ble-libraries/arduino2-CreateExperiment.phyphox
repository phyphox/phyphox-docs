<phyphox version="1.20">
<title>Create Experiment</title>
<category>Arduino Experiments</category>
<description>Random numbers are generated on Arduino and visualized with phyphox afterwards</description>
<data-containers>
	<container size="0">CH0</container>
	<container size="0">CH1</container>
	<container size="0">CH2</container>
	<container size="0">CH3</container>
	<container size="0">CH4</container>
	<container size="0">CH5</container>
</data-containers>
<input>
	<bluetooth name="create experiment" id="phyphoxBLE" mode="notification" subscribeOnStart="false">
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">CH1</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">CH2</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">CH3</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">CH4</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">CH5</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" extra="time">CH0</output>
	</bluetooth>
</input>
<output>
	<bluetooth id="phyphoxBLE" name="create experiment">
	</bluetooth>
</output>
<analysis sleep="0">
</analysis>
<views>
	<view label="FirstView">
		<graph label="Random number over time" labelX="time" labelY="random number" unitX="s" unitY="" xPrecision="1" yPrecision="1" scaleMinY="fixed" minY="0" scaleMaxY="fixed" maxY="100">
			<input axis="x">CH0</input>
			<input axis="y">CH1</input>
		</graph>
		<graph label="Random number squared over random number" labelX="random number" labelY="squared" unitX="" unitY="">
			<input axis="x">CH1</input>
			<input axis="y" color="2E728E" style="dots">CH2</input>
		</graph>
	</view>
	<view label="SecondView">
		<info label="This is an Info field!" color="890128" size="1.2"></info>
		<separator height="0.3" color="404040"></separator>
		<value label="Number" precision="2" unit="unit" color="FFFFFF" size="2">
			<input>CH0</input>
		</value>
	</view>
</views>
<export>
	<set name="mySet">
		<data name="myData1">CH1</data>
		<data name="myData2">CH2</data>
	</set>
</export>
</phyphox>
