<?xml version="1.0" encoding="UTF-8"?><phyphox locale="en" version="1.14">
    <title>Preview color modifiers</title>
    <category>Camera</category>
    <description>Test grayscale and over/under exposure markers</description>
    <icon>Y'</icon>
    <data-containers>
        <container size="0">luma</container>
        <container size="0">t</container>
        <container size="0">shutterSpeed</container>
        <container size="0">iso</container>
        <container size="0">aperture</container>
        <container size="0">exposure</container>
        <container size="1">count</container>
        <container size="1">rate</container>
    </data-containers>
    <input>
        <camera auto_exposure="true" feature="photometric" x1="0.4" x2="0.6" y1="0.4" y2="0.6">
            <output component="luma">luma</output>
            <output component="t">t</output>
            <output component="shutterSpeed">shutterSpeed</output>
            <output component="iso">iso</output>
            <output component="aperture">aperture</output>
        </camera>
    </input>
    <views>
        <view label="Normal">
            <separator height="1"/>
            <camera-gui label="Preview" exposure_adjustment_level="3" show_controls="full_view_only" locked=""/>
            <separator height="1"/>
            <value label="Average Luma" size="2">
                <input>luma</input>
            </value>

            <graph label="Luma" labelX="[[quantity_short_time]]" labelY="Luma" partialUpdate="true" unitX="[[unit_short_second]]">
                <input axis="x" lineWidth="2">t</input>
                <input axis="y">luma</input>
            </graph>

            <value label="Average rate" unit="Hz" precision="1">
                <input>rate</input>
            </value>

        </view>

        <view label="Grayscale">
            <separator height="1"/>
            <camera-gui label="Preview" exposure_adjustment_level="3" show_controls="full_view_only" locked="" grayscale="true"/>
            <separator height="1"/>
            <value label="Average Luma" size="2">
                <input>luma</input>
            </value>

            <graph label="Luma" labelX="[[quantity_short_time]]" labelY="Luma" partialUpdate="true" unitX="[[unit_short_second]]">
                <input axis="x" lineWidth="2">t</input>
                <input axis="y">luma</input>
            </graph>

            <value label="Average rate" unit="Hz" precision="1">
                <input>rate</input>
            </value>

        </view>

        <view label="Over">
            <separator height="1"/>
            <camera-gui label="Preview" exposure_adjustment_level="3" show_controls="full_view_only" locked="" grayscale="true" markOverexposure="red"/>
            <separator height="1"/>
            <value label="Average Luma" size="2">
                <input>luma</input>
            </value>

            <graph label="Luma" labelX="[[quantity_short_time]]" labelY="Luma" partialUpdate="true" unitX="[[unit_short_second]]">
                <input axis="x" lineWidth="2">t</input>
                <input axis="y">luma</input>
            </graph>

            <value label="Average rate" unit="Hz" precision="1">
                <input>rate</input>
            </value>

        </view>

        <view label="Under">
            <separator height="1"/>
            <camera-gui label="Preview" exposure_adjustment_level="3" show_controls="full_view_only" locked="" grayscale="true" markUnderexposure="blue"/>
            <separator height="1"/>
            <value label="Average Luma" size="2">
                <input>luma</input>
            </value>

            <graph label="Luma" labelX="[[quantity_short_time]]" labelY="Luma" partialUpdate="true" unitX="[[unit_short_second]]">
                <input axis="x" lineWidth="2">t</input>
                <input axis="y">luma</input>
            </graph>

            <value label="Average rate" unit="Hz" precision="1">
                <input>rate</input>
            </value>

        </view>

        <view label="O/U">
            <separator height="1"/>
            <camera-gui label="Preview" exposure_adjustment_level="3" show_controls="full_view_only" locked="" grayscale="true" markOverexposure="red" markUnderexposure="blue"/>
            <separator height="1"/>
            <value label="Average Luma" size="2">
                <input>luma</input>
            </value>

            <graph label="Luma" labelX="[[quantity_short_time]]" labelY="Luma" partialUpdate="true" unitX="[[unit_short_second]]">
                <input axis="x" lineWidth="2">t</input>
                <input axis="y">luma</input>
            </graph>

            <value label="Average rate" unit="Hz" precision="1">
                <input>rate</input>
            </value>

        </view>

        <view label="Color O/U">
            <separator height="1"/>
            <camera-gui label="Preview" exposure_adjustment_level="3" show_controls="full_view_only" locked="" markOverexposure="red" markUnderexposure="blue"/>
            <separator height="1"/>
            <value label="Average Luma" size="2">
                <input>luma</input>
            </value>

            <graph label="Luma" labelX="[[quantity_short_time]]" labelY="Luma" partialUpdate="true" unitX="[[unit_short_second]]">
                <input axis="x" lineWidth="2">t</input>
                <input axis="y">luma</input>
            </graph>

            <value label="Average rate" unit="Hz" precision="1">
                <input>rate</input>
            </value>

        </view>


    </views>
    <analysis>
        <count>
            <input clear="false">luma</input>
            <output>count</output>
        </count>
        <divide>
            <input clear="false">count</input>
            <input clear="false">t</input>
            <output>rate</output>
        </divide>
    </analysis>
    <export>
        <set name="Data">
            <data name="t">t</data>
            <data name="luma">luma</data>
        </set>
    </export>
</phyphox>
