<phyphox xmlns="http://phyphox.org/xml" version="1.7" locale="en">
    <title>golden vector: reduce/inflate</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/reduce.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="1.0,2.0">x</container>
        <container size="8" init="10.0,20.0">y</container>
        <container size="8">ox</container>
        <container size="8">oy</container>
    </data-containers>
    <analysis>
        <reduce>
            <input as="factor" type="value">0.5</input>
            <input as="x">x</input>
            <input as="y">y</input>
            <output as="x">ox</output>
            <output as="y">oy</output>
        </reduce>
    </analysis>
</phyphox>
