<phyphox xmlns="http://phyphox.org/xml" version="1.2" locale="en">
    <title>golden vector: sin/degrees</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/sin.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="0.0,30.0,45.0,90.0,180.0,-60.0">a</container>
        <container size="8">out</container>
    </data-containers>
    <analysis>
        <sin deg="true">
            <input>a</input>
            <output>out</output>
        </sin>
    </analysis>
</phyphox>
