<phyphox xmlns="http://phyphox.org/xml" version="1.2" locale="en">
    <title>golden vector: average/skips-non-finite</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/average.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="1.0,2.0,3.0,4.0,NaN,Infinity">a</container>
        <container size="1">avg</container>
        <container size="1">dev</container>
    </data-containers>
    <analysis>
        <average>
            <input>a</input>
            <output>avg</output>
            <output as="stddev">dev</output>
        </average>
    </analysis>
</phyphox>
