<phyphox xmlns="http://phyphox.org/xml" version="1.17" locale="en">
    <title>golden vector: execution/static-write-once</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/execution.yml - do not edit.</description>
    <data-containers>
        <container size="4" init="5">src</container>
        <container size="8">feed</container>
        <container size="1" static="true">total</container>
    </data-containers>
    <analysis>
        <append>
            <input keep="true">src</input>
            <output append="true">feed</output>
        </append>
        <count>
            <input>feed</input>
            <output>total</output>
        </count>
    </analysis>
    <views>
        <view label="golden vector">
            <separator />
        </view>
    </views>
</phyphox>
