<phyphox xmlns="http://phyphox.org/xml" version="1.17" locale="en">
    <title>golden vector: execution/requirefill-first-run-exempt</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/execution.yml - do not edit.</description>
    <data-containers>
        <container size="4">gate</container>
        <container size="4" init="1,2">src</container>
        <container size="8">out</container>
    </data-containers>
    <analysis requireFill="gate">
        <append>
            <input keep="true">src</input>
            <output append="true">out</output>
        </append>
    </analysis>
    <views>
        <view label="golden vector">
            <separator />
        </view>
    </views>
</phyphox>
