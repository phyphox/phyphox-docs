<phyphox xmlns="http://phyphox.org/xml" version="1.3" locale="en">
    <title>golden vector: if/untouched-keeps-init</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/if.yml - do not edit.</description>
    <data-containers>
        <container size="4" init="5.0">a</container>
        <container size="4" init="2.0">b</container>
        <container size="4" init="1.0">t</container>
        <container size="4" init="42.0">out</container>
    </data-containers>
    <analysis>
        <if less="true">
            <input as="a">a</input>
            <input as="b">b</input>
            <input as="true">t</input>
            <output as="result">out</output>
        </if>
    </analysis>
</phyphox>
