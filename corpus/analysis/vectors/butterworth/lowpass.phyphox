<phyphox xmlns="http://phyphox.org/xml" version="1.20" locale="en">
    <title>golden vector: butterworth/lowpass</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/butterworth.yml - do not edit.</description>
    <data-containers>
