<phyphox xmlns="http://phyphox.org/xml" version="1.0" locale="en">
    <title>golden vector: atan2/quadrants</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/atan2.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="1,1,-1,-1,0,2">y</container>
        <container size="8" init="1,-1,1,-1,-2,0">x</container>
        <container size="8">out</container>
    </data-containers>
    <analysis>
        <atan2>
            <input as="y">y</input>
            <input as="x">x</input>
            <output>out</output>
        </atan2>
    </analysis>
</phyphox>
