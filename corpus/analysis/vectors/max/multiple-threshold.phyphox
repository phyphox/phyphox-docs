<phyphox xmlns="http://phyphox.org/xml" version="1.0" locale="en">
    <title>golden vector: max/multiple-threshold</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/max.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="1.0,4.0,6.0,0.5,3.0,7.0,0.2">y</container>
        <container size="8">v</container>
        <container size="8">p</container>
    </data-containers>
    <analysis>
        <max multiple="true">
            <input as="y">y</input>
            <input as="threshold" type="value">2.0</input>
            <output as="max">v</output>
            <output as="position">p</output>
        </max>
    </analysis>
    <views>
        <view label="golden vector">
            <separator />
        </view>
    </views>
</phyphox>
