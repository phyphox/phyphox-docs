<phyphox xmlns="http://phyphox.org/xml" version="1.21" locale="en">
    <title>golden vector: ifft/normalization-forward</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/ifft.yml - do not edit.</description>
    <data-containers>
        <container size="4" init="10.0,-2.000000000000001,-2.0,-1.9999999999999982">re</container>
        <container size="4" init="0.0,1.9999999999999996,1.9999999999999991,-2.000000000000001">im</container>
