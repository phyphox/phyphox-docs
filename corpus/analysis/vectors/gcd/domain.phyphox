<phyphox xmlns="http://phyphox.org/xml" version="1.0" locale="en">
    <title>golden vector: gcd/domain</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/gcd.yml - do not edit.</description>
    <data-containers>
        <container size="4" init="-4,NaN,Infinity">a</container>
        <container size="4" init="2,2,2">b</container>
        <container size="4">out</container>
    </data-containers>
    <analysis>
        <gcd>
            <input>a</input>
            <input>b</input>
            <output>out</output>
        </gcd>
    </analysis>
</phyphox>
