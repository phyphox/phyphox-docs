<phyphox xmlns="http://phyphox.org/xml" version="1.2" locale="en">
    <title>golden vector: asin/degrees</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/asin.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="0.0,0.5,-0.5,1.0,-1.0">a</container>
        <container size="8">out</container>
    </data-containers>
    <analysis>
        <asin deg="true">
            <input>a</input>
            <output>out</output>
        </asin>
    </analysis>
    <views>
        <view label="golden vector">
            <separator />
        </view>
    </views>
</phyphox>
