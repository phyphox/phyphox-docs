<phyphox xmlns="http://phyphox.org/xml" version="1.0" locale="en">
    <title>golden vector: ramp/default-length</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/ramp.yml - do not edit.</description>
    <data-containers>
        <container size="4">out</container>
    </data-containers>
    <analysis>
        <ramp>
            <input as="start" type="value">1</input>
            <input as="stop" type="value">-2</input>
            <output>out</output>
        </ramp>
    </analysis>
</phyphox>
