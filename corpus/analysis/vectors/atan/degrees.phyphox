<phyphox xmlns="http://phyphox.org/xml" version="1.2" locale="en">
    <title>golden vector: atan/degrees</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/atan.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="0.0,1.0,-1.0,100.0">a</container>
        <container size="8">out</container>
    </data-containers>
    <analysis>
        <atan deg="true">
            <input>a</input>
            <output>out</output>
        </atan>
    </analysis>
</phyphox>
