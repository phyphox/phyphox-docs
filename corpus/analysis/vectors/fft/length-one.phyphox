<phyphox xmlns="http://phyphox.org/xml" version="1.0" locale="en">
    <title>golden vector: fft/length-one</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/fft.yml - do not edit.</description>
    <data-containers>
        <container size="1" init="2.5">re</container>
        <container size="1">outre</container>
        <container size="1">outim</container>
    </data-containers>
    <analysis>
        <fft>
            <input as="re">re</input>
            <output as="re">outre</output>
            <output as="im">outim</output>
        </fft>
    </analysis>
    <views>
        <view label="golden vector">
            <separator />
        </view>
    </views>
</phyphox>
