<phyphox xmlns="http://phyphox.org/xml" version="1.0" locale="en">
    <title>golden vector: tan/specials</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/tan.yml - do not edit.</description>
    <data-containers>
        <container size="4" init="NaN,Infinity,-Infinity">a</container>
        <container size="4">out</container>
    </data-containers>
    <analysis>
        <tan>
            <input>a</input>
            <output>out</output>
        </tan>
    </analysis>
    <views>
        <view label="golden vector">
            <separator />
        </view>
    </views>
</phyphox>
