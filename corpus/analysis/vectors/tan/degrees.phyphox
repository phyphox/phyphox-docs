<phyphox xmlns="http://phyphox.org/xml" version="1.2" locale="en">
    <title>golden vector: tan/degrees</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/tan.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="0.0,30.0,45.0,90.0,180.0,-60.0">a</container>
        <container size="8">out</container>
    </data-containers>
    <analysis>
        <tan deg="true">
            <input>a</input>
            <output>out</output>
        </tan>
    </analysis>
    <views>
        <view label="golden vector">
            <separator />
        </view>
    </views>
</phyphox>
