<phyphox xmlns="http://phyphox.org/xml" version="1.0" locale="en">
    <title>golden vector: multiply/unequal-lengths</title>
    <category>Analysis golden vectors</category>
    <description>Generated from corpus/analysis/cases/multiply.yml - do not edit.</description>
    <data-containers>
        <container size="8" init="1,2,3,4">a</container>
        <container size="8" init="2,0.5">b</container>
        <container size="8">out</container>
    </data-containers>
    <analysis>
        <multiply>
            <input>a</input>
            <input>b</input>
            <output>out</output>
        </multiply>
    </analysis>
</phyphox>
