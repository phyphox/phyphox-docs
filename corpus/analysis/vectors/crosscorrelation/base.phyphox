        <container size="8" init="1.0,0.5">b</container>
        <container size="8">out</container>
    </data-containers>
    <analysis>
        <crosscorrelation>
            <input>a</input>
            <input>b</input>
            <output>out</output>
        </crosscorrelation>
    </analysis>
</phyphox>
