      <string original="Acceleration">加速</string>
      <string original="Simple">シンプル</string>
    </translation>
    <translation locale="pt">
      <title>Aceleração com g</title>
      <category>Sensores</category>
      <description>Usa os dados diretos do acelerômetro. Este sensor não irá remover a força gravitacional, logo ele irá mostrar uma aceleração de 9.8 m/s² mesmo quando o aparelho estiver em repouso.</description>
